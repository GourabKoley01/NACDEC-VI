SetScriptVersion(Version="22.2.192")
system1 = GetSystem(Name="FFF")
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit()
geometry1.Exit()
template1 = GetTemplate(TemplateName="Geometry")
system2 = template1.CreateSystem()
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="H:/air ambulance/simulation of ducted fans/drawing/VF390_110160 Nacelle.stp")
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
geometry2.Edit()
geometry2.Exit()
system2.Delete()
system3 = template1.CreateSystem()
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.SetFile(FilePath="H:/air ambulance/simulation of ducted fans/drawing/VF390_110160 Nacelle.stp")
geometry3.Edit()
geometry3.Exit()
template2 = GetTemplate(TemplateName="Fluid Flow")
system4 = template2.CreateSystem()
geometryComponent1 = system3.GetComponent(Name="Geometry")
meshComponent1 = system4.GetComponent(Name="Mesh")
geometryComponent1.TransferData(TargetComponent=meshComponent1)
meshComponent1.Refresh()
mesh1 = system4.GetContainer(ComponentName="Mesh")
mesh1.Edit()
Save(Overwrite=True)
mesh1.Exit()
Save(Overwrite=True)
