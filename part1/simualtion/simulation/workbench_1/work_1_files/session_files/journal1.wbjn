# encoding: utf-8
# 2020 R1
SetScriptVersion(Version="20.1.164")
template1 = GetTemplate(TemplateName="FLTG")
system1 = template1.CreateSystem()
template2 = GetTemplate(TemplateName="Geometry")
system2 = template2.CreateSystem(
    Position="Right",
    RelativeTo=system1)
geometry1 = system2.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="F:/air ambulance/simulation/spaceclaim design/Air Ambulance 2 v3.scdoc")
geometryComponent1 = system2.GetComponent(Name="Geometry")
meshComponent1 = system1.GetComponent(Name="Mesh")
geometryComponent1.TransferData(TargetComponent=meshComponent1)
tGridCADImportOptions1 = GetDataEntity("/Mesh/TGridCADImportOptions:TGridCADImportOptions")
tGridCADImportOptions1.Units = "mm"
system3 = template2.CreateSystem(
    Position="Below",
    RelativeTo=system2)
geometry2 = system3.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="F:/air ambulance/simulation/spaceclaim design/Air Ambulance 2 v3.scdoc")
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
system3.Delete()
system4 = template2.CreateSystem(
    Position="Below",
    RelativeTo=system2)
geometry3 = system4.GetContainer(ComponentName="Geometry")
geometry3.SetFile(FilePath="F:/air ambulance/design/Air Ambulance single body.step")
geometry3.Edit(IsSpaceClaimGeometry=True)
geometry3.Exit()
system5 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system4)
geometryComponent2 = system4.GetComponent(Name="Geometry")
meshComponent2 = system5.GetComponent(Name="Mesh")
geometryComponent2.TransferData(TargetComponent=meshComponent2)
tGridCADImportOptions2 = GetDataEntity("/Mesh 1/TGridCADImportOptions:TGridCADImportOptions")
tGridCADImportOptions2.Units = "mm"
setup1 = system5.GetContainer(ComponentName="Setup")
fluentLauncherSettings1 = setup1.GetFluentLauncherSettings()
fluentLauncherSettings1.SetEntityProperties(Properties=Set(Precision="Double", EnvPath={}, RunParallel=True, NumberOfProcessorsMeshing=4, NumberOfProcessors=4))
tGridData1 = GetDataEntity("/Mesh 1/TGridData:TGridData")
tGridData1.SetEntityProperties(Properties=Set(RunParallel=True, NumberOfProcs=4))
mesh1 = system5.GetContainer(ComponentName="Mesh")
Fluent.Edit(Container=mesh1)
meshComponent2.Refresh()
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Import Geometry'].Execute()\")")
setup1.SendCommand(Command='(cx-use-window-id 1)(cx-use-window-id 1)(cx-use-window-id 1)(cx-gui-do cx-set-toggle-button2 "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*CheckButton5(Insert Clipping Planes)" #t)(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*CheckButton5(Insert Clipping Planes)")')
setup1.SendCommand(Command='(cx-gui-do cx-set-scale "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2" 94)(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2")')
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Local Sizing'].AddChildToTask()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Local Sizing'].Execute()\")")
setup1.SendCommand(Command='(cx-gui-do cx-activate-item "Error*OK")(cx-gui-do cx-activate-item "Error*OK")')
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Create Surface Mesh'].Arguments.setState({r'CFDSurfaceMeshControls': {r'MaxSize': 100,r'MinSize': 10,},})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Create Surface Mesh'].Execute()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Describe Geometry'].UpdateChildTasks(SetupTypeChanged=False)\")")
setup1.SendCommand(Command='(cx-gui-do cx-set-scale "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2" 99)(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2")')
setup1.SendCommand(Command='(cx-gui-do cx-set-scale "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2" 92)(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Task Page)*Table1*Table3(Clipping Planes)*Scale2")')
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Describe Geometry'].Arguments.setState({r'SetupType': r'The geometry consists of only fluid regions with no voids',})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Describe Geometry'].UpdateChildTasks(SetupTypeChanged=True)\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Describe Geometry'].Execute()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Update Boundaries'].Execute()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Update Regions'].Execute()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Boundary Layers'].Arguments.setState({r'BlLabelList': [r'front_wing', r'fuselage', r'landing_gear', r'rear_wing'],r'FaceScope': {r'GrowOn': r'selected-labels',},r'Rate': 0.9,})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Boundary Layers'].AddChildToTask()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Boundary Layers'].InsertCompoundChildTask()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['smooth-transition_1'].Arguments.setState({r'BLControlName': r'smooth-transition_1',r'BlLabelList': [r'front_wing', r'fuselage', r'landing_gear', r'rear_wing'],r'FaceScope': {r'GrowOn': r'selected-labels',},r'Rate': 0.9,})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Add Boundary Layers'].Arguments.setState({})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['smooth-transition_1'].Execute()\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Create Volume Mesh'].Arguments.setState({r'VolumeFill': r'poly-hexcore',})\")")
setup1.SendCommand(Command="(%py-exec \"workflow.TaskObject['Create Volume Mesh'].Execute()\")")
system2.Delete()
system1.Delete()
Save(Overwrite=True)
setup1.SendCommand(Command='(cx-gui-do cx-activate-item "MenuBar*FileMenu*Close Fluent")')
